<!-- Wazuh manager integration blocks (Slack #wazuh-alerts + #wazuh-demo, and VirusTotal).
     Append to the manager config (config/wazuh_cluster/wazuh_manager.conf) - config-as-code per Phase 6.
     Real webhook URLs and the VT API key are secrets - fill the placeholders. -->

<ossec_config>
  <integration>
    <name>virustotal</name>
    <api_key><VIRUSTOTAL_API_KEY></api_key>
    <group>syscheck</group>
    <alert_format>json</alert_format>
  </integration>
</ossec_config>

<ossec_config>
  <integration>
    <name>slack</name>
    <hook_url><SLACK_WEBHOOK_URL></hook_url>
    <level>7</level>
    <alert_format>json</alert_format>
  </integration>
</ossec_config>

<ossec_config>
  <!-- DEMO CHANNEL (#wazuh-demo): lower threshold, scoped to high-signal groups only -->
  <integration>
    <name>slack</name>
    <hook_url><SLACK_WEBHOOK_URL></hook_url>
    <level>5</level>
    <group>sudo,syscheck</group>
    <alert_format>json</alert_format>
  </integration>
</ossec_config>
